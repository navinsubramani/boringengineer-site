# Copy this file to .env and fill in your values:  cp .env.example .env
# .env is gitignored and dockerignored, so it never gets committed or baked into the image.

# PostHog "Project token" (Project settings → starts with phc_). Leave empty to build without analytics.
POSTHOG_KEY=

# Optional: private registry to push to with `./build-image.sh --push` (e.g. <registry-ip>:<port>)
REGISTRY=

# Server CPU architecture: linux/amd64 (Intel/AMD, default) or linux/arm64 (e.g. Raspberry Pi).
# Check on the server with `uname -m`: x86_64 → linux/amd64, aarch64 → linux/arm64
PLATFORM=linux/amd64

# Optional: image name and tag (defaults: boringengineer-site / latest)
IMAGE_NAME=boringengineer-site
IMAGE_TAG=latest
